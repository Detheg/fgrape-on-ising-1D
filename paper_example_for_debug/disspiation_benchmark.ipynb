   "source": [
    "import dynamiqs as dq\n",
    "import jax.numpy as jnp\n",
    "\n",
    "n = 16\n",
    "a = dq.destroy(n)\n",
    "\n",
    "H = a.dag() @ a\n",
    "jump_ops = [a]\n",
    "psi0 = dq.coherent(n, 1.0)\n",
    "\n",
    "result = dq.mesolve(H, jump_ops, psi0, tsave=[1], options=dq.Options(t0=0))\n",
    "print(result)"
   ]
  },
